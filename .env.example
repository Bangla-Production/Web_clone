# ==============================================================================
# ABAR KHABO — ROOT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Note: In development, Abar Khabo can run in zero-config offline mode with
# Firebase Local Emulators or local fallbacks.
# For production or connecting to live Firebase, copy this file to:
#   - client/.env (for frontend Vite client)
#   - server/.env (for backend Node.js Express server)
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION (used by server/)
# ------------------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# Firebase Admin SDK Configuration
# For local development with emulator:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_PROJECT_ID=demo-abar-khabo
# GCLOUD_PROJECT=demo-abar-khabo

# For staging / production with live Firebase:
# FIREBASE_PROJECT_ID=your-firebase-project-id
# GCLOUD_PROJECT=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Webhook Secrets for Aggregator Ingestion (HMAC-SHA256 signature verification)
SWIGGY_WEBHOOK_SECRET=your-swiggy-webhook-secret-key-32chars
ZOMATO_WEBHOOK_SECRET=your-zomato-webhook-secret-key-32chars
GENERIC_WEBHOOK_SECRET=your-generic-webhook-secret-key-32chars

# Optional Logging
DEBUG=false

# ------------------------------------------------------------------------------
# FRONTEND VITE CONFIGURATION (used by client/)
# ------------------------------------------------------------------------------
# Firebase Web App Config (From Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Backend REST API endpoint consumed by the frontend
VITE_API_URL=http://localhost:8080/api

# ImgBB Cloud Media API Key for dish image uploads (Get free key at https://api.imgbb.com/)
VITE_IMGBB_API_KEY=your-imgbb-api-key

# Optional: Firebase App Check reCAPTCHA v3 Site Key
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
# VITE_APP_CHECK_DEBUG_TOKEN=true
