# ==============================================================================
# ABAR KHABO — BACKEND SERVER ENVIRONMENT CONFIGURATION TEMPLATE (server/.env.example)
# ==============================================================================
# Copy this file to server/.env to configure the Node.js backend server.
# In local development without server/.env, sensible defaults and demo fallbacks
# are automatically applied.
# ==============================================================================

# Server HTTP Port (Cloud Run sets this automatically to 8080)
PORT=8080
NODE_ENV=development

# ------------------------------------------------------------------------------
# FIREBASE ADMIN SDK & FIRESTORE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Local Development with Firebase Emulator
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_PROJECT_ID=demo-abar-khabo
# GCLOUD_PROJECT=demo-abar-khabo

# Option B: Connecting to Live Firebase Project
# FIREBASE_PROJECT_ID=your-firebase-project-id
# GCLOUD_PROJECT=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ------------------------------------------------------------------------------
# AGGREGATOR WEBHOOK INGESTION SECRETS (HMAC-SHA256 signature verification)
# ------------------------------------------------------------------------------
SWIGGY_WEBHOOK_SECRET=your-swiggy-webhook-secret-key-32chars
ZOMATO_WEBHOOK_SECRET=your-zomato-webhook-secret-key-32chars
GENERIC_WEBHOOK_SECRET=your-generic-webhook-secret-key-32chars

# ------------------------------------------------------------------------------
# LOGGING & DIAGNOSTICS
# ------------------------------------------------------------------------------
DEBUG=false
