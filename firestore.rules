rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // 1. CORE AUTHENTICATION & IDENTITY HELPERS
    // ─────────────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Super Admin: platform owner email or explicit role in /users/{email}
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'altcafe2026@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'super_admin')
      );
    }

    // Helper to check UID profile
    function hasUidProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper to check legacy email profile
    function hasEmailProfile() {
      return isAuthenticated() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    // Helper to get staff user profile (prefers UID, falls back to legacy email)
    function userProfile() {
      return hasUidProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function hasActiveProfile() {
      return isAuthenticated() &&
        (hasUidProfile() || hasEmailProfile()) &&
        userProfile().get('status', 'active') == 'active' &&
        (request.auth.token.email_verified == true || userProfile().get('authMethod', '') == 'staffId');
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 2. TENANT BOUNDARY & ROLE-BASED ACCESS HELPERS
    // ─────────────────────────────────────────────────────────────────────────

    // Restaurant Admin / Owner: Full management of their own tenant
    function isRestaurantAdmin(restId) {
      return isSuperAdmin() || (
        hasActiveProfile() &&
        userProfile().role in ['restaurant_admin', 'owner'] &&
        userProfile().restaurantId == restId
      );
    }

    // Restaurant Staff: Any authenticated staff member of this specific restaurant
    function isRestaurantStaff(restId) {
      return isSuperAdmin() || (
        hasActiveProfile() &&
        userProfile().role in ['restaurant_admin', 'owner', 'outlet_manager', 'staff', 'waiter', 'cashier', 'kitchen'] &&
        userProfile().restaurantId == restId
      );
    }

    // Outlet Access Authorization:
    // 1. Must belong to the restaurant (strict tenant isolation)
    // 2. allOutlets: true grants access across all outlets of that restaurant
    // 3. allOutlets: false allows access only to explicitly assigned outlets
    // 4. Missing or empty assignedOutletIds with allOutlets != true strictly DENIES access
    function hasOutletAccess(restId, outletId) {
      return isSuperAdmin() || (
        isRestaurantStaff(restId) && (
          userProfile().get('allOutlets', false) == true ||
          (userProfile().get('assignedOutletIds', []) is list &&
           outletId in userProfile().get('assignedOutletIds', []))
        )
      );
    }

    // Kitchen Staff: Allowed to update cooking status & KOTs
    function isKitchenAuthorized(restId) {
      return isSuperAdmin() || (
        hasActiveProfile() &&
        userProfile().role in ['restaurant_admin', 'owner', 'kitchen', 'staff'] &&
        userProfile().restaurantId == restId
      );
    }

    // Cashier Staff: Allowed to settle bills, manage invoices & assign riders
    function isCashierAuthorized(restId) {
      return isSuperAdmin() || (
        hasActiveProfile() &&
        userProfile().role in ['restaurant_admin', 'owner', 'cashier', 'staff'] &&
        userProfile().restaurantId == restId
      );
    }

    // Waiter Staff: Allowed to take floor orders and create KOTs
    function isWaiterAuthorized(restId) {
      return isSuperAdmin() || (
        hasActiveProfile() &&
        userProfile().role in ['restaurant_admin', 'owner', 'waiter', 'staff'] &&
        userProfile().restaurantId == restId
      );
    }

    // Customer Identity check (authenticated end-consumer)
    function isCustomerOwner(customerId) {
      return isAuthenticated() && (request.auth.uid == customerId || isSuperAdmin());
    }

    // Delivery Partner (Rider) check
    function isDeliveryPartner() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@rider\\..*'))
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3. USER ACCOUNTS & PROFILES (/users/{userEmail})
    // ─────────────────────────────────────────────────────────────────────────

    match /users/{userId} {
      // Super admin can read any profile.
      // Staff can read their own profile (matching either auth UID or lowercase email).
      // Restaurant admin can read profiles of staff within their own restaurant.
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == userId)) ||
        (hasActiveProfile() && userProfile().role in ['restaurant_admin', 'owner'] &&
         resource.data.restaurantId == userProfile().restaurantId);

      // Super admin can create any user.
      // Restaurant admin can create staff for their own restaurant.
      // Prohibits creating super_admin or owner; prevents unauthorized allOutlets assignment.
      allow create: if isSuperAdmin() || (
        hasActiveProfile() &&
        userProfile().role in ['restaurant_admin', 'owner'] &&
        request.resource.data.restaurantId == userProfile().restaurantId &&
        request.resource.data.role in ['outlet_manager', 'waiter', 'kitchen', 'cashier', 'staff'] &&
        request.resource.data.role != 'super_admin' &&
        request.resource.data.role != 'owner' &&
        (request.resource.data.get('allOutlets', false) == false || userProfile().role == 'owner')
      );

      // Super admin can update any profile.
      // Restaurant admin can update staff profiles within their own restaurant (cannot escalate to super_admin or owner).
      // Self-update: Staff can update contact & display fields, but CANNOT tamper with role, restaurantId, allOutlets, or assignedOutletIds.
      allow update: if isSuperAdmin() || (
        hasActiveProfile() &&
        userProfile().role in ['restaurant_admin', 'owner'] &&
        resource.data.restaurantId == userProfile().restaurantId &&
        request.resource.data.restaurantId == userProfile().restaurantId &&
        request.resource.data.role != 'super_admin' &&
        request.resource.data.role != 'owner'
      ) || (
        isAuthenticated() &&
        (request.auth.uid == userId || request.auth.token.email == userId) &&
        request.resource.data.get('role', resource.data.get('role', 'waiter')) == resource.data.get('role', 'waiter') &&
        request.resource.data.get('restaurantId', '') == resource.data.get('restaurantId', '') &&
        request.resource.data.get('allOutlets', false) == resource.data.get('allOutlets', false) &&
        request.resource.data.get('assignedOutletIds', []) == resource.data.get('assignedOutletIds', [])
      );

      // Super admin or Restaurant admin deleting staff from their own restaurant
      allow delete: if isSuperAdmin() || (
        hasActiveProfile() &&
        userProfile().role in ['restaurant_admin', 'owner'] &&
        resource.data.restaurantId == userProfile().restaurantId
      );
    }

    // Staff Lookup: Maps numeric Staff ID -> internal login email
    match /staffLookup/{staffId} {
      allow read: if true; // Publicly readable for pre-auth staff ID login resolution
      allow create, update, delete: if isSuperAdmin() || (
        hasActiveProfile() &&
        userProfile().role in ['restaurant_admin', 'owner']
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. CUSTOMER ACCOUNTS & ADDRESSES (/customers/{customerId})
    // ─────────────────────────────────────────────────────────────────────────

    match /customers/{customerId} {
      allow read: if isCustomerOwner(customerId);
      allow create: if isAuthenticated() && request.auth.uid == customerId;
      allow update: if isCustomerOwner(customerId);
      allow delete: if isSuperAdmin();

      match /addresses/{addressId} {
        allow read, write: if isCustomerOwner(customerId);
      }
    }

    // Customer Addresses root fallback
    match /customerAddresses/{customerId} {
      allow read, write: if isCustomerOwner(customerId);

      match /addresses/{addressId} {
        allow read, write: if isCustomerOwner(customerId);
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 5. RESTAURANTS & TENANT SUBCOLLECTIONS (/restaurants/{restaurantId})
    // ─────────────────────────────────────────────────────────────────────────

    match /restaurants/{restaurantId} {
      // Public discovery on Abar Khabo homepage and customer portal
      allow read: if true;

      // Only Super Admin can onboard new restaurants or delete restaurants
      allow create, delete: if isSuperAdmin();

      // Super Admin or assigned Restaurant Admin can update details (branding, address, phone)
      allow update: if isSuperAdmin() || (
        isRestaurantAdmin(restaurantId) &&
        request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
      );

      // Categories & Menu Items: Publicly readable for QR / online ordering; Admin write
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isRestaurantAdmin(restaurantId);
      }

      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isRestaurantAdmin(restaurantId);
      }

      // Master Menu Catalog (Enterprise multi-outlet catalog)
      match /menuCatalog/{itemId} {
        allow read: if true;
        allow write: if isRestaurantAdmin(restaurantId);
      }

      // Tables: Floor management for restaurant staff
      match /tables/{tableId} {
        allow read, write: if isRestaurantStaff(restaurantId);
      }

      // Orders (Dine-in / Counter POS): Restaurant staff only
      match /orders/{orderId} {
        allow read, create, update: if isRestaurantStaff(restaurantId);
        allow delete: if isRestaurantAdmin(restaurantId);
      }

      // Kitchen Order Tickets (KOTs)
      match /kots/{kotId} {
        allow read, create, update: if isRestaurantStaff(restaurantId);
        allow delete: if isRestaurantAdmin(restaurantId);
      }

      // Invoices & Billing
      match /invoices/{invoiceId} {
        allow read, create, update: if isRestaurantStaff(restaurantId);
        allow delete: if isRestaurantAdmin(restaurantId);
      }

      // Inventory & Stock Transactions
      match /inventory/{itemId} {
        allow read: if isRestaurantStaff(restaurantId);
        allow write: if isRestaurantAdmin(restaurantId);

        match /transactions/{txnId} {
          allow read: if isRestaurantStaff(restaurantId);
          allow write: if isRestaurantAdmin(restaurantId);
        }
      }

      // Table Reservations: Public guest create; Staff manage
      match /reservations/{resId} {
        allow read: if isRestaurantStaff(restaurantId);
        allow create: if true;
        allow update, delete: if isRestaurantStaff(restaurantId);
      }

      // Audit Logs & Settings
      match /auditLogs/{logId} {
        allow read: if isRestaurantAdmin(restaurantId);
        allow create: if isRestaurantStaff(restaurantId);
        allow update, delete: if isSuperAdmin();
      }

      match /settings/{settingId} {
        allow read: if isRestaurantStaff(restaurantId);
        allow write: if isRestaurantAdmin(restaurantId);
      }

      match /customers/{custId} {
        allow read, write: if isRestaurantStaff(restaurantId);
      }

      // Subcollection copy of Online Orders
      match /onlineOrders/{orderId} {
        allow read, write: if isRestaurantStaff(restaurantId);
      }

      // Outlets (Multi-Tenant Outlets Schema)
      match /outlets/{outletId} {
        allow read: if true;
        allow write: if isRestaurantAdmin(restaurantId);

        // Outlet-Specific Menu Overrides & Channel Pricing
        match /menuOverrides/{itemId} {
          allow read: if true;
          // Permitted for Restaurant Admin or assigned Outlet Manager with outlet access
          allow write: if isRestaurantAdmin(restaurantId) || (
            hasOutletAccess(restaurantId, outletId) &&
            userProfile().role in ['outlet_manager', 'owner', 'restaurant_admin']
          );
        }

        // Aggregator Connections (Swiggy, Zomato API credentials — Never Public)
        match /aggregatorConnections/{connectionId} {
          allow read, write: if isRestaurantAdmin(restaurantId);
        }
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 6. ONLINE ORDERS & FOOD DELIVERY (/onlineOrders/{orderId})
    // ─────────────────────────────────────────────────────────────────────────

    match /onlineOrders/{orderId} {
      // READ PERMISSIONS:
      // 1. Super Admin
      // 2. Staff belonging to the order's restaurant (strict tenant isolation)
      // 3. Authenticated Customer who owns the order (by customerId or phone)
      // 4. Assigned Rider or active Rider viewing available orders
      // Public users CANNOT read arbitrary/guessed order IDs.
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && isRestaurantStaff(resource.data.restaurantId)) ||
        (isAuthenticated() && (
          resource.data.get('customerId', '') == request.auth.uid ||
          resource.data.get('riderId', '') == request.auth.uid ||
          resource.data.get('partnerId', '') == request.auth.uid
        )) ||
        (isDeliveryPartner() && resource.data.orderType == 'DELIVERY');

      // CREATE PERMISSIONS:
      // Customers or guests placing an order: must start with PLACED status and valid restaurantId
      allow create: if (
        request.resource.data.restaurantId != null &&
        request.resource.data.get('status', 'PLACED') == 'PLACED' &&
        request.resource.data.totalAmount >= 0
      ) || isSuperAdmin() || isRestaurantStaff(request.resource.data.restaurantId);

      // UPDATE PERMISSIONS:
      // 1. Super Admin: full access
      // 2. Restaurant Staff: can update order status for their own restaurant (cannot alter totalAmount, items, or restaurantId)
      // 3. Assigned Rider: can only update delivery-specific fields (status, riderCoordinates, deliveryStatus, timestamps)
      // Client updates CANNOT alter payment amounts, restaurant ownership, or ordered items!
      allow update: if isSuperAdmin() ||
        (isAuthenticated() && isRestaurantStaff(resource.data.restaurantId) &&
         request.resource.data.restaurantId == resource.data.restaurantId &&
         request.resource.data.totalAmount == resource.data.totalAmount &&
         request.resource.data.items == resource.data.items) ||
        (isAuthenticated() && (
          resource.data.get('riderId', '') == request.auth.uid ||
          request.resource.data.get('riderId', '') == request.auth.uid
        ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'deliveryStatus', 'riderId', 'riderName', 'riderPhone',
          'riderPhoto', 'riderVehicle', 'riderVehicleNumber', 'isAadhaarVerified',
          'assignedAt', 'pickedUpAt', 'deliveredAt', 'updatedAt'
        ]));

      // DELETE PERMISSIONS:
      // Only Super Admin or the Restaurant Admin of that specific restaurant
      allow delete: if isSuperAdmin() ||
        (isAuthenticated() && isRestaurantAdmin(resource.data.restaurantId));
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 7. LIVE GPS DELIVERY TRACKING (/deliveryTracking/{orderId})
    // ─────────────────────────────────────────────────────────────────────────

    match /deliveryTracking/{orderId} {
      // READ: Public users CANNOT read GPS coordinates or private tracking by guessing order IDs.
      // Only super admin, restaurant staff of that restaurant, customer owner, or assigned rider.
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && isRestaurantStaff(resource.data.restaurantId)) ||
        (isAuthenticated() && (
          resource.data.get('customerId', '') == request.auth.uid ||
          resource.data.get('riderId', '') == request.auth.uid ||
          resource.data.get('partnerId', '') == request.auth.uid
        ));

      // Create: Initialized when order is placed or dispatched
      allow create: if isAuthenticated() ||
        request.resource.data.restaurantId != null;

      // Update:
      // 1. Super Admin
      // 2. Restaurant Staff for their own restaurant's orders
      // 3. Assigned Rider updating GPS coordinates or delivery status
      allow update: if isSuperAdmin() ||
        (isAuthenticated() && isRestaurantStaff(resource.data.restaurantId)) ||
        (isAuthenticated() && (
          resource.data.get('riderId', '') == request.auth.uid ||
          request.resource.data.get('riderId', '') == request.auth.uid
        ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'riderCoordinates', 'status', 'lastUpdatedAt', 'riderPhone', 'riderName', 'riderVehicle', 'riderPhoto', 'isAadhaarVerified'
        ]));

      allow delete: if isSuperAdmin() ||
        (isAuthenticated() && isRestaurantAdmin(resource.data.restaurantId));
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 8. DELIVERY PARTNERS (/deliveryPartners/{partnerId})
    // ─────────────────────────────────────────────────────────────────────────

    match /deliveryPartners/{partnerId} {
      // Read:
      // 1. Super Admin
      // 2. The delivery partner themselves
      // 3. Restaurant staff looking up active riders for dispatch
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && request.auth.uid == partnerId) ||
        hasActiveProfile();

      // Create:
      // 1. Super Admin
      // 2. Rider registering their own account
      // 3. Restaurant staff registering a rider
      allow create: if isSuperAdmin() ||
        (isAuthenticated() && request.auth.uid == partnerId) ||
        hasActiveProfile();

      // Update:
      // 1. Super Admin: full access
      // 2. Delivery partner updating availability & GPS coordinates
      //    (CANNOT alter isAadhaarVerified, kycStatus, status, or aadhaarMasked)
      // 3. Restaurant staff assigning an order (can only modify isAvailable, currentOrderId)
      allow update: if isSuperAdmin() ||
        (isAuthenticated() && request.auth.uid == partnerId &&
         request.resource.data.get('isAadhaarVerified', false) == resource.data.get('isAadhaarVerified', false) &&
         request.resource.data.get('kycStatus', '') == resource.data.get('kycStatus', '') &&
         request.resource.data.get('status', 'APPROVED') == resource.data.get('status', 'APPROVED') &&
         request.resource.data.get('aadhaarMasked', '') == resource.data.get('aadhaarMasked', '')) ||
        (hasActiveProfile() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAvailable', 'currentOrderId', 'updatedAt']));

      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 9. SYSTEM EMAIL NOTIFICATIONS & AUDIT LOGS
    // ─────────────────────────────────────────────────────────────────────────

    match /email_notifications/{notificationId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }
  }
}
