rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Every RestoPulse login is a real Firebase Authentication user, and each
    // has a profile document at users/{email} (lower-case email) holding role,
    // restaurantId and status. Keyed by email so an account can be deleted and
    // the same email can be added again later.
    // ------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    // The platform owner (create this login in Firebase Console -> Authentication).
    // Checked FIRST so it works even before a profile document exists.
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'altcafe2026@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'super_admin')
      );
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function hasActiveProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
        profile().get('status', 'active') == 'active' &&
        // Real email/password admins must have clicked their confirmation
        // link. Staff-ID accounts (waiter/kitchen/cashier) have no real
        // inbox to confirm, so they're trusted instead by the Firestore-side
        // authMethod flag, which only a Restaurant Admin can set (see the
        // users/{userId} create rule) and only for their own restaurant.
        (request.auth.token.email_verified == true || profile().get('authMethod', '') == 'staffId');
    }

    function isRestaurantAdmin(restId) {
      return isSuperAdmin() || (
        hasActiveProfile() &&
        profile().role == 'restaurant_admin' &&
        profile().restaurantId == restId
      );
    }

    function isRestaurantStaff(restId) {
      return isSuperAdmin() || (
        hasActiveProfile() &&
        profile().role in ['restaurant_admin', 'staff', 'waiter', 'cashier', 'kitchen'] &&
        profile().restaurantId == restId
      );
    }

    // Staff roles a Restaurant Admin is allowed to manage
    function isStaffRole(role) {
      return role in ['waiter', 'kitchen', 'cashier', 'staff'];
    }

    // 1. Users (profiles)
    match /users/{userId} {
      // Own profile, everything for the platform owner, and a Restaurant Admin
      // can read the profiles of their own restaurant.
      allow read: if isAuthenticated() && (
        request.auth.token.email == userId ||
        isSuperAdmin() ||
        (hasActiveProfile() &&
         profile().role == 'restaurant_admin' &&
         resource.data.restaurantId == profile().restaurantId)
      );

      // Platform owner creates anything (Restaurant Admins).
      // A Restaurant Admin can only create staff for their own restaurant.
      // Email-based staff (legacy) start "pending"; Staff-ID based staff
      // (waiter/kitchen/cashier created via numeric ID + password, no email
      // to confirm) start "active" immediately.
      allow create: if isSuperAdmin() || (
        hasActiveProfile() &&
        profile().role == 'restaurant_admin' &&
        isStaffRole(request.resource.data.role) &&
        request.resource.data.restaurantId == profile().restaurantId &&
        (
          request.resource.data.status == 'pending' ||
          (request.resource.data.status == 'active' && request.resource.data.authMethod == 'staffId')
        )
      );

      allow update: if isSuperAdmin()
        // A user may only flip their OWN profile from pending -> active,
        // and only after Firebase confirms their email. Nothing else.
        || (isAuthenticated() &&
            request.auth.token.email == userId &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'active' &&
            request.auth.token.email_verified == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'emailVerified', 'updatedAt']))
        // A Restaurant Admin manages their own staff (never their role / restaurant).
        || (hasActiveProfile() &&
            profile().role == 'restaurant_admin' &&
            isStaffRole(resource.data.role) &&
            resource.data.restaurantId == profile().restaurantId &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.restaurantId == resource.data.restaurantId);

      allow delete: if isSuperAdmin() || (
        hasActiveProfile() &&
        profile().role == 'restaurant_admin' &&
        isStaffRole(resource.data.role) &&
        resource.data.restaurantId == profile().restaurantId
      );
    }

    // 1b. Staff Lookup — maps a numeric Staff ID -> internal login email so
    // the Staff Login screen can resolve an ID to an email BEFORE the person
    // is authenticated. Contains no password. Publicly readable (like a
    // phonebook of IDs); only the owning restaurant's admin can write.
    match /staffLookup/{staffId} {
      allow read: if true;
      allow create: if isRestaurantAdmin(request.resource.data.restaurantId);
      allow update, delete: if isRestaurantAdmin(resource.data.restaurantId);
    }

    // 2. Restaurants
    match /restaurants/{restaurantId} {
      // Public read for the customer digital menu and branding
      allow read: if true;

      allow create, delete: if isSuperAdmin();
      allow update: if isRestaurantAdmin(restaurantId);

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isRestaurantStaff(restaurantId);
      }

      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isRestaurantStaff(restaurantId);
      }

      match /tables/{tableId} {
        allow read, write: if isRestaurantStaff(restaurantId);
      }

      match /orders/{orderId} {
        allow read, write: if isRestaurantStaff(restaurantId);
      }

      match /kots/{kotId} {
        allow read, write: if isRestaurantStaff(restaurantId);
      }

      match /invoices/{invoiceId} {
        allow read, write: if isRestaurantStaff(restaurantId);
      }

      match /inventory/{itemId} {
        allow read, write: if isRestaurantStaff(restaurantId);

        match /transactions/{txnId} {
          allow read, write: if isRestaurantStaff(restaurantId);
        }
      }

      match /reservations/{resId} {
        allow read: if isRestaurantStaff(restaurantId);
        allow create: if true; // guests can book from the public menu
        allow update, delete: if isRestaurantStaff(restaurantId);
      }

      match /auditLogs/{logId} {
        allow read: if isRestaurantStaff(restaurantId);
        allow create: if isRestaurantStaff(restaurantId);
      }

      match /settings/{settingId} {
        allow read: if isRestaurantStaff(restaurantId);
        allow write: if isRestaurantAdmin(restaurantId);
      }

      match /customers/{custId} {
        allow read, write: if isRestaurantStaff(restaurantId);
      }
    }
  }
}
