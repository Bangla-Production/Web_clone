# ==============================================================================
# ABAR KHABO — CLIENT ENVIRONMENT CONFIGURATION TEMPLATE (client/.env.example)
# ==============================================================================
# Copy this file to client/.env to connect the frontend to your Firebase project.
# In local development without client/.env, fallback demo credentials will be used.
# ==============================================================================

# Firebase Cloud Database & Authentication (Web App Config from Firebase Console)
# Firebase Console -> Project Settings -> General -> Your apps -> Web app (</>)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Backend Server API URL
VITE_API_URL=http://localhost:8080/api

# ImgBB API Key for Menu Image Uploads (Get a free key at https://api.imgbb.com/)
VITE_IMGBB_API_KEY=your-imgbb-api-key

# Optional: Firebase App Check Security (reCAPTCHA v3)
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
# VITE_APP_CHECK_DEBUG_TOKEN=true
